menu "FC7300 FCSMU Configuration"
	depends on FC7300_FCSMU

config FC7300_FCSMU_ISR_PRIORITY
	int "ISR PRIORITY"
	default 192

choice
	prompt "Configuration State Timeout Interval"
	default FC7300_FCSMU_CFG_TIMEOUT_MODE5

config FC7300_FCSMU_CFG_TIMEOUT_MODE0
	bool "170us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE1
	bool "341us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE2
	bool "682us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE3
	bool "1365us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE4
	bool "2730us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE5
	bool "5461us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE6
	bool "10922us"

config FC7300_FCSMU_CFG_TIMEOUT_MODE7
	bool "21845us"

endchoice

config FC7300_FCSMU_CFG_TIMEOUT_INTERRUPT_ENABLE
	bool "Configuration State Timeout Interrupt Enable"
	default n

config FC7300_FCSMU_WARNING_TIMEOUT
	int "FCSMU WARNING TIMEOUT INTERVAL(us)"
	default 10000
	range 0 17000

menuconfig FC7300_FCSMU_SOUT_PINS_ENABLE
	bool "SOUT Pins Enable"
	default n
	---help---
		Enable FCSMU SOUT Pins

if FC7300_FCSMU_SOUT_PINS_ENABLE

config FC7300_FCSMU_SOUT_DIVIDER_RATIO
	int "SOUT Divider Ratio"
	default 0
	range 0 1023
	---help---
		SOUT Divider Ratio
		SOUT_freq = CLKSAFE_freq/((SOUT_DIV+1)*2*256). SIRC12M clock is used
		as the source of CLKSAFE(CLKSAFE freq=12M).
		0: Divided by 512
		1: Divided by 1024
		2: Divided by 1536
		...
		1023: Divided by 524288

choice
	prompt "SOUT Potocol"
	default FC7300_FCSMU_SOUT_PROTOCOL_MODE0

config FC7300_FCSMU_SOUT_PROTOCOL_MODE0
	bool "Dual-Rail"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE1
	bool "Time-Switch"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE2
	bool "Bistable"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE3
	bool "Fault-Toggle"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE4
	bool "Time-Dual-Rail"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE5
	bool "DIAG0"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE6
	bool "DIAG1"

config FC7300_FCSMU_SOUT_PROTOCOL_MODE7
	bool "DIAG2"

endchoice

config FC7300_FCSMU_SOUT_OUTPUT0
	bool "Force SOUT0 high"
	default n
	depends on FC7300_FCSMU_SOUT_PROTOCOL_MODE6 || FC7300_FCSMU_SOUT_PROTOCOL_MODE7

config FC7300_FCSMU_SOUT_OUTPUT1
	bool "Force SOUT1 high"
	default n
	depends on FC7300_FCSMU_SOUT_PROTOCOL_MODE5 || FC7300_FCSMU_SOUT_PROTOCOL_MODE6

config FC7300_FCSMU_SOUT_POLARITY_SWITCH
	bool "SOUT Polarity Switch"
	default n

config FC7300_FCSMU_SOUT_FASTMODE_ENABLE
	bool "SOUT Fast Mode Enable"
	default n
	---help---
		Enable FCSMU SOUT Fast Mode.
		Note: Fast mode only applies to Dual-Rail and Time-Switch modes.
		SOUT will update immediately after FCSMU goes to the fault state.

config FC7300_FCSMU_SOUT_SMRDT
	int "SOUT Safe Mode Request Delay"
	default 0
	range 0 15
	---help---
		Safe Mode Request Delay Timer
		Configure the safe mode request delay in cycles of safe clock.
		0000b - 1 cycle
		0001b - 2 cycles
		0010b - 4 cycles
		0011b - 8 cycles
		…
		1111b - 32,768 cycles

choice
	prompt "SOUT Control"
	default FC7300_FCSMU_SOUT_CTRL_MODE0

config FC7300_FCSMU_SOUT_CTRL_MODE0
	bool "MODE0"
	---help---
		SOUT is controlled by the FSM.

config FC7300_FCSMU_SOUT_CTRL_MODE1
	bool "MODE1"
	---help---
		SOUT keeps low.

config FC7300_FCSMU_SOUT_CTRL_MODE2
	bool "MODE2"
	---help---
		SOUT is controlled by the FSM.

config FC7300_FCSMU_SOUT_CTRL_MODE3
	bool "MODE3"
	---help---
		SOUT keeps high until a fault occurs on a channel, then controlled
		by FSM.
endchoice

config FC7300_FCSMU_MINI_TIME
	int "MIN_TIME"
	default 0
	range 0 16383
	---help---
		This field controls the minimum amount of time that SOUT keeps stable
		in Fault-Toggle mode.

endif # FC7300_FCSMU_SOUT_PINS_ENABLE

