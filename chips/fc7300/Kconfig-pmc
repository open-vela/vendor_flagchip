menu "FC7300 Power Management Controller Configuration"
	depends on FC7300_PMC

config FC7300_PMC_ISR_PRIORITY
	int "ISR PRIORITY"
	default 192

config FC7300_PMC_RPM_VDD2P5_ENABLE
	bool "V25 Domain Enable during RPM"
	default n

config FC7300_PMC_V15_AUTOSW_ENABLE
	bool "V15 Auto Switch Enable"
	default n
	---help---
		PMC will automatically switch back to V15 LDO driver from V15
		controller with on board NPN driver if V15 is low and LVD1P5V
		event happens, once V15 is stable, it will automatically switch
		back.

config FC7300_PMC_V15_CTRL_ENABLE
	bool "V15 Controller with Onboard NPN Enable"
	default y

config FC7300_PMC_5VB_MON_ENABLE
	bool "VDD5V_B LVR Monitor Enable during RPM"
	default n

config FC7300_PMC_HVD_INTERRUPT_ENABLE
	bool "High Voltage Detect Interrupt Enable"
	default n

config FC7300_PMC_LVD_INTERRUPT_ENABLE
	bool "Low Voltage Detect Interrupt Enable"
	default n

config FC7300_PMC_V15_LOCK
	bool "Lock Control for V15_EXT_EN and V15_AUTOSW"
	default n

endmenu # FC7300 PMC Configuration
