# Chip Selection

choice
	prompt "FC7300 Chip Selection"
	default ARCH_CHIP_FC7300F8M_320PIN

config ARCH_CHIP_FC7300F8M_320PIN
	bool "FC7300F8M_320PIN"
	select ARCH_CHIP_FC7300F8M
	---help---
		Cortex-M7F, 8Mb FLASH, 512Kb RAM incl.

endchoice # FC7300 Chip Selection

# Chip Family

config ARCH_CHIP_FC7300F8M
	bool
	select ARCH_CHIP_FC7300XXX
	select FC7300XXX_HAVE_ETHERNET

config ARCH_CHIP_FC7300XXX
	bool
	select ARCH_CORTEXM7
	select ARMV7M_HAVE_ICACHE
	select ARMV7M_HAVE_DCACHE
	select ARCH_HAVE_MPU
	select ARM_HAVE_MPU_UNIFIED
	select ARCH_HAVE_FPU
	select ARCH_HAVE_RAMFUNCS
	select ARCH_HAVE_I2CRESET
	select ARCH_HAVE_TICKLESS
	select ARCH_HAVE_SPI_BITORDER
	select ARCH_HAVE_POWEROFF
	select ARCH_HAVE_HEAP2
	select ARCH_HAVE_ADDRENV
	select ARCH_HAVE_MULTICPU
	select ARCH_HAVE_CUSTOM_TESTSET

