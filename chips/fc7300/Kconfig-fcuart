menu "FC7300 FCUART Configuration"
	depends on FC7300_FCUART

config FC7300_FCUART_ISR_THREAD
	bool "FCUART ISR THREAD"
	default n
	---help---
		Select the fcuart interrupt function to execute in thread context.

config FC7300_FCUART_ISR_THREAD_PRIORITY
	int "FCUART ISR THREAD PRIORITY"
	default 250
	range 0 255
	depends on FC7300_FCUART_ISR_THREAD
	---help---
		The priority of isr thread.

config FC7300_FCUART_ISR_THREAD_STACKSIZE
	int "FCUART ISR THREAD STACK SIZE"
	default 1500
	range 0 4096
	depends on FC7300_FCUART_ISR_THREAD
	---help---
		The stack size of fcuart isr thread.

config FC7300_FCUART_RXDMA_BUFFER_SIZE
	int "Rx DMA buffer size"
	default 64
	depends on FCUART0_RXDMA || FCUART1_RXDMA || FCUART2_RXDMA || FCUART3_RXDMA || FCUART4_RXDMA || FCUART5_RXDMA || \
               FCUART7_RXDMA || FCUART8_RXDMA || FCUART9_RXDMA || FCUART10_RXDMA || FCUART11_RXDMA || FCUART12_RXDMA || \
               FCUART13_RXDMA || FCUART14_RXDMA || FCUART15_RXDMA || FCUART16_RXDMA || FCUART17_RXDMA
	---help---
		The DMA buffer size when using RX DMA to emulate a FIFO.

		When streaming data, the generic serial layer will be called
		every time the FIFO receives half this number of bytes.

config FC7300_FCUART_INVERT
	bool "Signal Invert Support"
	default n

#####################################################################################

menu "FCUART0 Configuration"
	depends on FCUART0_SERIALDRIVER

config FCUART0_RXBUFSIZE
	int "Receive buffer size"
	default 256
	---help---
		Characters are buffered as they are received. This specifies
		the size of the receive buffer.

config FCUART0_TXBUFSIZE
	int "Transmit buffer size"
	default 256
	---help---
		Characters are buffered before being sent.  This specifies
		the size of the transmit buffer.

config FCUART0_BAUD
	int "BAUD rate"
	default 115200
	---help---
		The configured BAUD of the FCUART.

config FCUART0_BITS
	int "Character size"
	default 8
	---help---
		The number of bits.  Must be either 7 or 8.

config FCUART0_PARITY
	int "Parity setting"
	default 0
	range 0 2
	---help---
		0=no parity, 1=odd parity, 2=even parity

config FCUART0_2STOP
	int "Uses 2 stop bits"
	default 0
	---help---
		1=Two stop bits
choice
	prompt "IFLOW Control"
	default FCUART0_NOIFLOWCONTROL

config FCUART0_NOIFLOWCONTROL
	bool "No IFLOW control"
	---help---
		No IFLOW control

config FCUART0_IFLOWCONTROL
	bool "RTS for IFLOW control"
	select SERIAL_IFLOWCONTROL
	---help---
		Enable RTS flow control
endchoice

config FCUART0_INVERTIFLOWCONTROL
	depends on FCUART0_IFLOWCONTROL
	bool "Invert sense of RTS bit"
	default n
	---help---
		Make RTS bit active high rather than active low

config FCUART0_OFLOWCONTROL
	bool "CTS OFLOW control"
	default n
	select SERIAL_OFLOWCONTROL
	---help---
		Enable CTS flow control

config FCUART0_RXDMA
	bool "FCUART0 Rx DMA support"
	default n
	select SERIAL_RXDMA
	---help---
		Enable Rx DMA transfers on FCUART0

config FCUART0_RXDMA_CHANNEL
	depends on FCUART0_RXDMA
	int "FCUART0 Rx DMA Channel"
	default 0
	range 0 31
	---help---
		Select Rx DMA channel for FCUART0
		Note: DMA channel for each peripheral Tx/Rx shall be different

config FCUART0_TXDMA
	bool "FCUART0 Tx DMA support"
	default n
	select SERIAL_TXDMA
	---help---
		Enable Tx DMA transfers on FCUART0

config FCUART0_TXDMA_CHANNEL
	depends on FCUART0_TXDMA
	int "FCUART0 Tx DMA Channel"
	default 0
	range 0 31
	---help---
		Select Tx DMA channel for FCUART0
		Note: DMA channel for each peripheral Tx/Rx shall be different

endmenu

