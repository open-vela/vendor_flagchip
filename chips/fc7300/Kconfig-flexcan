config FC7300_FLEXCAN0_CANFD_DATA_PRESDIV
	int "CAN FD Data Presdiv"
	depends on FC7300_FLEXCAN0_CANFD_BRS
	range 1 1024
	default 3
	---help---
		Default 3 condition : Select PLL0 clock src and clock divide is 1, Fcanclk = 150M.
		Upon this condition, CAN FD baudrate is 2M, sample point is 80%.

config FC7300_FLEXCAN0_CANFD_DATA_PROPSEG
	int "CAN FD Data Propseg"
	depends on FC7300_FLEXCAN0_CANFD_BRS
	default 10
	---help---
		The sum of Data Propseg plus Data Pseg1 must be less than 32.
		Default 10 condition : Select PLL0 clock src and clock divide is 1, Fcanclk = 150M.
