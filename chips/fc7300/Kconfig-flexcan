menu "FC7300 FLEXCAN Configuration"
	depends on FC7300_FLEXCAN

config FC7300_FLEXCAN_ENHANCED_RX_FIFO
	bool
	default y

config FC7300_FLEXCAN_CANFD_BRS
	bool
	default n

config FC7300_FLEXCAN_CANFD_SSP
	bool
	default n

config FC7300_FLEXCAN_CAN_ERROR_INTERRUPT
	bool "FLEXCAN Error Interrupt"
	default n
	select CAN_ERRORS
	---help---
		If y, it will enable BIT1ERR/BIT0ERR/ACKERR/CRCERR/FRMERR/STFERR interrupt request.
		If n, BIT1ERR/BIT0ERR/ACKERR/CRCERR/FRMERR/STFERR can only be got by polling.

config FC7300_FLEXCAN_ISR_THREAD
	bool "FLEXCAN ISR THREAD"
	default n
	---help---
		Select the flexcan interrupt function to execute in thread context.

config FC7300_FLEXCAN_ISR_THREAD_PRIORITY
	int "FLEXCAN ISR THREAD PRIORITY"
	default 251
	range 0 255
	depends on FC7300_FLEXCAN_ISR_THREAD
	---help---
		The priority of isr thread.

config FC7300_FLEXCAN_ISR_THREAD_STACKSIZE
	int "FLEXCAN ISR THREAD STACK SIZE"
	default 2048
	range 0 4096
	depends on FC7300_FLEXCAN_ISR_THREAD
	---help---
		The stack size of flexcan isr thread.

menu "FC7300 FLEXCAN0 Configuration"
	depends on FC7300_FLEXCAN0

choice
	prompt "Character driver or SocketCAN support"
	default FC7300_FLEXCAN0_SOCKET

config FC7300_FLEXCAN0_CHARDRIVER
	bool "Character driver support"
	select FC7300_FLEXCAN_CHARDRIVER

config FC7300_FLEXCAN0_SOCKET
	bool "SocketCAN support"
	select FC7300_FLEXCAN_SOCKET

endchoice # FLEXCAN0 character driver or SocketCAN support

config FC7300_FLEXCAN0_CANFD
	bool "Use CAN FD"
	default y
	select CAN_FD if FC7300_FLEXCAN0_CHARDRIVER
	select NET_CAN_HAVE_CANFD if FC7300_FLEXCAN0_SOCKET

config FC7300_FLEXCAN0_CANFD_BRS
	bool "CAN FD Bit Rate Switch"
	depends on FC7300_FLEXCAN0_CANFD
