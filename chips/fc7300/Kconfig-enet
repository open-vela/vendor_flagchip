menu "FC7300 Ethernet Configuration"
	depends on FC7300_ENET

config FC7300_ENET_IRQ_ATTACH_THREAD
	bool "FC7300 ENET ISR Attach Thread"
	default n
	---help---
		Select the ENET interrupt function to execute in thread context.

config FC7300_ENET_IRQ_THREAD_PRIORITY
	int "FC7300 ENET IRQ Thread Priority"
	default 250
	range 0 255
	depends on FC7300_ENET_IRQ_ATTACH_THREAD
	---help---
		The priority of isr thread.

config FC7300_ENET_PHY_BOADINIT
	bool "Board-specific PHY Initialization"
	default n
	depends on FC7300_ENET
	---help---
		When this configuration is selected, the function int fc7300_phy_boardinitialize(int)
		must be provided by the board level. The etehenet driver will call this function
		in initialization funtion.

config FC7300_ENET_MULTIPLE_QUEUES
	bool
	default n

config FC7300_ENET_PHY_YT8531S
	bool
	default n

config FC7300_ENET_PHY_RTL8211F
	bool
	default n

menu "FC7300 Ethernet0 Configuration"
	depends on FC7300_ENET0

choice
	prompt "FC7300 ENET0 PHY Interface Selection"
	default FC7300_ENET0_PHYIF_RGMII

config FC7300_ENET0_PHYIF_MII
	bool "ENET MII Interface"
	depends on FC7300_ENET0
	---help---
		Select the MII interface.

config FC7300_ENET0_PHYIF_RMII
	bool "ENET RMII Interface"
	depends on FC7300_ENET0
	---help---
		Select the RMII interface.

config FC7300_ENET0_PHYIF_RGMII
	bool "ENET RGMII Interface"
	depends on FC7300_ENET0
	---help---
		Select the RGMII interface.

endchoice # FC7300 ENET0 PHY Interface Selection

menu "FC7300 ENET0 RGMII Configuration"
	depends on FC7300_ENET0_PHYIF_RGMII

config FC7300_ENET0_RGMII_TXDELAY
	int "RGMII TX Clock Delay"
	default 0
	range 0 255
	---help---
		RGMII TX clock delay in 50 picoseconds per step.

config FC7300_ENET0_RGMII_RXDELAY
	int "RGMII RX Clock Delay"
	default 0
	range 0 255
	---help---
		RGMII RX clock delay in 50 picoseconds per step.

choice
	prompt "RGMII Clock Selection"
	default FC7300_ENET0_RGMII_CLK_PLL1DIVH

config FC7300_ENET0_RGMII_CLK_REFPIN
	bool "RGMII Clock Source Reference Pin"
	---help---
		Select RGMII TX clock source from reference pin.

config FC7300_ENET0_RGMII_CLK_PLL0DIVH
	bool "RGMII Clock Source PLL0DIVH"
	---help---
		Select RGMII TX clock source from PLL0 DIVH.

config FC7300_ENET0_RGMII_CLK_PLL1DIVH
	bool "RGMII Clock Source PLL1DIVH"
	---help---
		Select RGMII TX clock source from PLL1 DIVH.

endchoice # RGMII Clock Selection
endmenu # FC7300 ENET0 RGMII Configuration

choice
	prompt "FC7300 ENET0 PHY Type Selection"
	default FC7300_ENET0_PHY_YT8531S

config FC7300_ENET0_PHY_YT8531S
	bool "YT8531S PHY"
	depends on FC7300_ENET0
	select FC7300_ENET_PHY_YT8531S
	---help---
		Select YT8531S phy.

config FC7300_ENET0_PHY_RTL8211F
	bool "RTL8211F PHY"
	depends on FC7300_ENET0
	select FC7300_ENET_PHY_RTL8211F
	---help---
		Select RTL8211F phy.

endchoice # FC7300 ENET0 PHY Type Selection

menu "FC7300 ENET0 PHY Link Configuration"

config FC7300_ENET0_PHY_ADDR
	int "Phy Address"
	default 0
	range 0 31
	depends on FC7300_ENET0
	---help---
		The phy address configured on the board.

config FC7300_ENET0_PHY_PIN_CLKOUT
	bool "PHY Clock Pin Output"
	default y
	depends on FC7300_ENET0
	---help---
		Enable PHY clock pin output.

config FC7300_ENET0_AUTONEGO
	bool "Auto Negotiation"
	default y
	depends on FC7300_ENET0
	---help---
		Enable auto-negotiation.

choice
	prompt "Link Speed Selection"
	default FC7300_ENET0_SPEED_1000MBPS
	depends on !FC7300_ENET0_AUTONEGO

config FC7300_ENET0_SPEED_1000MBPS
	bool "1000MBPS"
	depends on FC7300_ENET0_PHYIF_RGMII
	---help---
		Select link speed 1000MBPS.

config FC7300_ENET0_SPEED_100MBPS
	bool "100MBPS"
	---help---
		Select link speed 100MBPS.

config FC7300_ENET0_SPEED_10MBPS
	bool "10MBPS"
	---help---
		Select link speed 10MBPS.

endchoice # Link Speed Selection

config FC7300_ENET0_FULLDUPLEX
	bool "Full Duplex Mode"
	default y
	depends on FC7300_ENET0
	depends on !FC7300_ENET0_AUTONEGO
	---help---
		Select the MAC link in full or half duplex mode, default full duplex mode.

endmenu # FC7300 ENET0 PHY Link Configuration

config FC7300_ENET0_MULTIPLE_QUEUES
	bool "FC7300 ENET0 Enable Multiple Queues"
	default n
	depends on FC7300_ENET0
  select FC7300_ENET_MULTIPLE_QUEUES
	---help---
		Enable multiple MTL queues and DMA channels, default only MTL queue 0 and
		DMA channel 0 are enabled.

config FC7300_ENET0_AV_MODE
	bool "FC7300 ENET0 AV Mode"
	default n
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
		Enable traffic shaper for audio video data.

menu "FC7300 ENET0 Channel/Queue 0 Configuration"

config FC7300_ENET0_NTX0DESC
	int "Number DMA Transmit Descriptors"
	default 4
	range 2 64
	depends on FC7300_ENET0
	---help---
		The number of Transmit DMA descriptors and buffers.

config FC7300_ENET0_NRX0DESC
	int "Number DMA Receive Descriptors"
	default 8
	range 2 64
	depends on FC7300_ENET0
	---help---
		The number of Receive DMA descriptors and buffers.

config FC7300_ENET0_TXBUFFER0_SIZE
	int "Transmit Buffer Size in Bytes"
	default 1520
	range 64 1536
	depends on FC7300_ENET0
	---help---
		The size (in bytes) of Transmit buffers.

config FC7300_ENET0_RXBUFFER0_SIZE
	int "Receive Buffer Size in Bytes"
	default 1520
	range 64 1536
	depends on FC7300_ENET0
	---help---
		The size (in bytes) of Receive buffers.

config FC7300_ENET0_TX0_ISR_PRIORITY
	int "Transmit Interrupt Priority"
	default 192
	range 0 255
	depends on FC7300_ENET0
	---help---
		Select the interrupt priority of Ethernet0 Tx Queue0.

config FC7300_ENET0_RX0_ISR_PRIORITY
	int "Receive Interrupt Priority"
	default 192
	range 0 255
	depends on FC7300_ENET0
	---help---
		Select the interrupt priority of Ethernet0 Rx Queue0.

config FC7300_ENET0_DMATXCH0_WEIGHT
	int "DMA TX Channel Weight"
	default 0
	range 0 7
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
		Configure the transmit weights between multiple DMA channels.

config FC7300_ENET0_MTLTXQ0_WEIGHT
	int "MTL TX Queue Weight"
	default 0
	range 0 100
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
		Configure the transmit weights between multiple MTL queues.

config FC7300_ENET0_MTLRXQ0_WEIGHT
	int "MTL RX Queue Weight"
	default 0
	range 0 100
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
		Configure the receive weights between multiple MTL queues.

endmenu # FC7300 ENET0 Channel/Queue 0 Configuration

menu "FC7300 ENET0 Channel/Queue 1 Configuration"
