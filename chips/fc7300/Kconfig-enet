config FC7300_ENET0_RXBUFFER1_SIZE
	int "Receive Buffer Size in Bytes"
	default 1520
	range 64 1536
	depends on FC7300_ENET0
	---help---
		The size (in bytes) of Receive buffers.

config FC7300_ENET0_TX1_ISR_PRIORITY
	int "Transmit Interrupt Priority"
	default 192
	range 0 255
	depends on FC7300_ENET0
	---help---
		Select the interrupt priority of Ethernet0 Tx Queue1.

config FC7300_ENET0_RX1_ISR_PRIORITY
	int "Receive Interrupt Priority"
	default 192
	range 0 255
	depends on FC7300_ENET0
	---help---
		Select the interrupt priority of Ethernet0 Rx Queue1.

config FC7300_ENET0_DMATXCH1_WEIGHT
	int "DMA TX Channel Weight"
	default 0
	range 0 7
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
		Configure the transmit weights between multiple DMA channels.

config FC7300_ENET0_MTLTXQ1_WEIGHT
	int "MTL TX Queue Weight"
	default 0
	range 0 100
	depends on FC7300_ENET0_MULTIPLE_QUEUES
	---help---
