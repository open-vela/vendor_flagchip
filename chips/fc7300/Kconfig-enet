config FC7300_ENET0_PTP_ENABLE
	bool "FC7300 ENET0 PTP Enable"
	default y
	depends on FC7300_ENET0
	---help---
		Enable IEEE 1588 precision time protocol.

menu "FC7300 ENET0 PTP Configuration"
	depends on FC7300_ENET0_PTP_ENABLE

choice
	prompt "PTP Clock Selection"
	default FC7300_ENET0_PTP_CLKSEL_PCC

config FC7300_ENET0_PTP_CLKSEL_PCC
	bool "ENET PCC Clock"
	---help---
		Select ENET PCC clock as PTP clock source.

config FC7300_ENET0_PTP_CLKSEL_TXCLK
	bool "ENET TX Clock"
	---help---
		Select ENET TX clock as PTP clock source.

config FC7300_ENET0_PTP_CLKSEL_REFPIN
	bool "ENET Reference Pin Input Clock"
	---help---
		Select ENET reference pin (PTG8) input clock as PTP clock source.

endchoice # PTP Clock Selection

config FC7300_ENET0_PTP_REFPIN_FREQ
	int "Reference Pin Input Clock Frequency"
	default 125000000
	depends on FC7300_ENET0_PTP_CLKSEL_REFPIN
	---help---
		If Reference Pin Input Clock is selected as the PTP source clock,
		The Input Clock frequency must be specified.

config FC7300_ENET0_PTP_INCREMENT_STEP
	int "Increment Step in Nanoseconds"
	default 20
	range 7 255
	---help---
		The increment step in nanoseconds of the PTP system time. This value
		must be greater than (1000000000 / ptpclock). For example, if the
		ptpclock is 50Mhz, the minimum value is 20.

config FC7300_ENET0_PTP_VERSION2
	bool "PTP Version 2 Format"
	default y
	---help---
		Enable PTP packet processing for version 2 format.

config FC7300_ENET0_PTP_AV8021AS
	bool "AV 802.1AS Mode"
	default n
	---help---
		Enable AV 802.1AS Mode.

config FC7300_ENET0_PTP_ALL_PACKETS
	bool "Timestamp for All Packets"
	default n
	---help---
		Timestamp snapshot is enabled for all packets received by the MAC.

config FC7300_ENET0_PTP_SNAPSHOT_TYPE
	int "Snapshot Type Select"
	default 8
	range 0 15
	---help---
		Snapshot packets type select. This value is the combination of
		SNAPTYPSEL, TSMSTRENA, and TSEVNTENA defined in Timestamp Control
		register bits[17:14].

choice
	prompt "PTP Processing Layer"
	default FC7300_ENET0_PTP_OVER_IPV4UDP

config FC7300_ENET0_PTP_OVER_IPV4UDP
	bool "Timestamp Over IPV4 UDP"
	---help---
		 Processes the PTP packets encapsulated in IPv4-UDP packets.

config FC7300_ENET0_PTP_OVER_IPV6UDP
	bool "Timestamp Over IPV6 UDP"
	---help---
		 Processes the PTP packets encapsulated in IPv6-UDP packets.

config FC7300_ENET0_PTP_OVER_ETHERNET
	bool "Timestamp Over Ethernet"
	---help---
		 Processes the PTP packets encapsulated in ethernet packets.

endchoice # PTP Processing Layer

endmenu # FC7300 ENET0 PTP Configuration

config FC7300_ENET0_SYS_ISR_PRIORITY
	int "FC7300 ENET0 System Interrupt Priority"
	default 192
	range 0 255
	depends on FC7300_ENET0
	---help---
		Select the interrupt priority of Ethernet0 System Interrupt.

endmenu # FC7300 Ethernet0 Configuration

endmenu # FC7300 Ethernet Configuration