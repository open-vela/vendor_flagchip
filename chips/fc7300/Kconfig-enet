		Configure the receive weights between multiple MTL queues.

config FC7300_ENET0_TXQ1_IDLESLOPE
	int "Transmit Queue Idle Slope Credit"
	default 0
	range 0 8192
	depends on FC7300_ENET0_AV_MODE
	---help---
		When AV feature is enabled, this field contains the idleSlopeCredit
		value required for the credit-based shaper.

config FC7300_ENET0_TXQ1_SENDSLOPE
	int "Transmit Queue Send Slope Credit"
	default 0
	range 0 8192
	depends on FC7300_ENET0_AV_MODE
	---help---
