#include "memory_layout.h"

MEMORY
{
  kflash            (rx)  : ORIGIN = KERNEL_PFLASH_START,   LENGTH = KERNEL_PFLASH_SIZE
  uflash            (rx)  : ORIGIN = USER_PFLASH_START,     LENGTH = USER_PFLASH_SIZE
  dflash            (rx)  : ORIGIN = DFLASH_START,          LENGTH = DFLASH_SIZE
  vram              (rwx) : ORIGIN = VRAM_START,            LENGTH = VRAM_SIZE
  itcm_func         (rwx) : ORIGIN = ITCM_FUNC_START,       LENGTH = ITCM_FUNC_SIZE
  itcm_heap         (rwx) : ORIGIN = ITCM_HEAP_START,       LENGTH = ITCM_HEAP_SIZE
  dtcm_stack        (rw)  : ORIGIN = DTCM_STACK_START,      LENGTH = DTCM_STACK_SIZE
  dtcm_user         (rw)  : ORIGIN = DTCM_USER_START,       LENGTH = DTCM_USER_SIZE
  dtcm_data         (rw)  : ORIGIN = DTCM_DATA_START,       LENGTH = DTCM_DATA_SIZE
  standby_ram       (rw)  : ORIGIN = STANDBY_RAM_START,     LENGTH = STANDBY_RAM_SIZE
  standby_ram_fix   (rw)  : ORIGIN = STANDBY_RAM_FIX_START, LENGTH = STANDBY_RAM_FIX_SIZE
  ksram             (rwx) : ORIGIN = KERNEL_SRAM_START,     LENGTH = KERNEL_SRAM_SIZE
  usram             (rwx) : ORIGIN = USER_SRAM_START,       LENGTH = USER_SRAM_SIZE
  boot_share        (rwx) : ORIGIN = BOOT_SHARE_START,      LENGTH = BOOT_SHARE_SIZE
  coredump          (rwx) : ORIGIN = COREDUMP_START,        LENGTH = COREDUMP_SIZE
  kcalib            (rwx) : ORIGIN = CALIB_KERNEL_START,    LENGTH = CALIB_KERNEL_SIZE
  ucalib            (rwx) : ORIGIN = CALIB_USER_START,      LENGTH = CALIB_USER_SIZE
}

OUTPUT_ARCH(arm)
EXTERN(_vectors)
ENTRY(_stext)

SECTIONS
{
  .text :  ALIGN(4)
  {
    . = ALIGN(1024); /* VTOR must be align to 1K */
    _stext = ABSOLUTE(.);
    *(.vectors)
    . = ALIGN(4);
    *(.text .text.*)
    *(.fixup)
    *(.gnu.warning)
    *(.rodata .rodata.*)
    *(.gnu.linkonce.t.*)
    *(.glue_7)
    *(.glue_7t)
    *(.got)
    *(.gcc_except_table)
    *(.gnu.linkonce.r.*)
    . = ALIGN(8);
    _etext = ABSOLUTE(.);
  } > kflash

  .init_section :  ALIGN(4)
  {
    _sinit = ABSOLUTE(.);
    KEEP(*(SORT_BY_INIT_PRIORITY(.init_array.*) SORT_BY_INIT_PRIORITY(.ctors.*)))
    KEEP(*(.init_array EXCLUDE_FILE(*crtbegin.o *crtbegin?.o *crtend.o *crtend?.o) .ctors))
    . = ALIGN(4);
    _einit = ABSOLUTE(.);
  } > kflash

  .ARM.extab :  ALIGN(4)
  {
    *(.ARM.extab*)
    . = ALIGN(4);
  } > kflash

  .ARM.exidx :  ALIGN(4)
  {
    __exidx_start = ABSOLUTE(.);
    *(.ARM.exidx*)
    . = ALIGN(4);
    __exidx_end = ABSOLUTE(.);
  } > kflash

  /* The RAM vector table (if present) should be 1KB aligned */

  .ram_vectors (NOLOAD):
  {
    . = ALIGN(1024);
    *(.ram_vectors)
  } > vram

  .ramfunc : ALIGN(4)
  {
    _sramfuncs = ABSOLUTE(.);
    *(.ramfunc  .ramfunc.*)
    . = ALIGN(4);
    _eramfuncs = ABSOLUTE(.);
  } > itcm_func AT > kflash

  _framfuncs = LOADADDR(.ramfunc);

  .data :  ALIGN(4)
  {
    _sdata = ABSOLUTE(.);
    *(.data .data.*)
    *(.gnu.linkonce.d.*)
    CONSTRUCTORS
    . = ALIGN(8);
    _edata = ABSOLUTE(.);
  } > ksram AT > kflash

  .bss (NOLOAD) :  ALIGN(4)
  {
    _sbss = ABSOLUTE(.);
    *(.bss .bss.*)
    *(.gnu.linkonce.b.*)
    *(COMMON)
    . = ALIGN(4);
    _ebss = ABSOLUTE(.);
  } > ksram

  .standbyram (NOLOAD) :  ALIGN(4)
  {
    _sstandby_ram = ABSOLUTE(.);
    *(.runtime_overflow .runtime_overflow.*)
    *(.no_init)
    . = ALIGN(4);
    _estandby_ram = ABSOLUTE(.);
  } > standby_ram

  .standbyramfix (NOLOAD) :  ALIGN(4)
  {
    _sstandby_ram_fix = ABSOLUTE(.);
    *(.standby_ramfix .standby_ramfix.*)
    . = ALIGN(4);
    _estandby_ram_fix = ABSOLUTE(.);
  } > standby_ram_fix

  _eronly = LOADADDR(.data);

  .bootshare (NOLOAD):  ALIGN(4)
  {
    _sbootshare = ABSOLUTE(.);
    KEEP(*(SORT(.bootshare)))
    . = ALIGN(4);
    _ebootshare = ABSOLUTE(.);
  } > boot_share

  .dumpshare (NOLOAD):
  {
    _sdumpshare = ABSOLUTE(.);
    *(.dump_share*)
    . = ALIGN(4);
    _edumpshare = ABSOLUTE(.);
  } > coredump

  .calibra :  ALIGN(4)
  {
    _scalibra = ABSOLUTE(.);
    *(.calibra .calibra.*)
    . = ALIGN(8);
    _ecalibra = ABSOLUTE(.);
  } > kcalib AT > kflash

  _calib_pflash = LOADADDR(.calibra);

  .dtcmstack (NOLOAD) :  ALIGN(4)
  {
    _sdtcm_stack = ABSOLUTE(.);
    *(SORT(.dtcm_stack.*) SORT(.dtcm_stack))
    . = ALIGN(4);
    _edtcm_stack = ABSOLUTE(.);
  } > dtcm_stack

  .dtcmdata :  ALIGN(4)
  {
    _sdtcm_data = ABSOLUTE(.);
    *(.dtcm_data .dtcm_data.*)
    . = ALIGN(4);
    _edtcm_data = ABSOLUTE(.);
  } > dtcm_data AT > kflash
  _sdtcmdata_rom = LOADADDR(.dtcmdata);

  /* Stabs debugging sections. */

  .stab 0 : { *(.stab) }
  .stabstr 0 : { *(.stabstr) }
  .stab.excl 0 : { *(.stab.excl) }
  .stab.exclstr 0 : { *(.stab.exclstr) }
  .stab.index 0 : { *(.stab.index) }
  .stab.indexstr 0 : { *(.stab.indexstr) }
  .comment 0 : { *(.comment) }
  .debug_abbrev 0 : { *(.debug_abbrev) }
  .debug_info 0 : { *(.debug_info) }
  .debug_line 0 : { *(.debug_line) }
  .debug_pubnames 0 : { *(.debug_pubnames) }
  .debug_aranges 0 : { *(.debug_aranges) }

  _pflash_start = PFLASH_START;
  _pflash_end = PFLASH_START + 0x200000;
  _kflash_start = ORIGIN(kflash);
  _kflash_end = ORIGIN(kflash) + LENGTH(kflash);
  _uflash_start = ORIGIN(uflash);
  _uflash_end = ORIGIN(uflash) + LENGTH(uflash);
  _dflash_start = ORIGIN(dflash);
  _dflash_end = ORIGIN(dflash) + LENGTH(dflash);
  _itcm_start = ORIGIN(vram);
  _itcm_end = ORIGIN(vram) + 0x10000;
  _itcm_func_start = ORIGIN(itcm_func);
  _itcm_func_end = ORIGIN(itcm_func) + LENGTH(itcm_func);
  _itcm_heap_start = ORIGIN(itcm_heap);
  _itcm_heap_size = LENGTH(itcm_heap);
  _dtcm_start = ORIGIN(dtcm_stack);
  _dtcm_end = ORIGIN(dtcm_stack) + 0x20000;
  _dtcm_stack_start = ORIGIN(dtcm_stack);
  _dtcm_stack_end = ORIGIN(dtcm_stack) + LENGTH(dtcm_stack);
  _dtcm_user_stack_start = ORIGIN(dtcm_user);
  _dtcm_user_stack_end = ORIGIN(dtcm_user) + LENGTH(dtcm_user);
  _dtcm_data_start = ORIGIN(dtcm_data);
  _dtcm_data_end = ORIGIN(dtcm_data) + LENGTH(dtcm_data);
  _dtcm_heap_start = _edtcm_data;
  _dtcm_heap_size = LENGTH(dtcm_data) - (_edtcm_data - _sdtcm_data);
  _ksram_start = ORIGIN(ksram);
  _ksram_end = ORIGIN(ksram) + LENGTH(ksram);
  _usram_start = ORIGIN(usram);
  _usram_end = ORIGIN(usram) + LENGTH(usram);
  _boot_shr_start = ORIGIN(boot_share);
  _boot_shr_end = ORIGIN(boot_share) + LENGTH(boot_share);
  _core0_kcalib_start = CORE0_CALIB_KERNEL_START;
  _vram_start = ORIGIN(vram);
  _vram_end = ORIGIN(vram) + LENGTH(vram);
  _coredump_start = ORIGIN(coredump);
  _coredump_end = ORIGIN(coredump) + LENGTH(coredump);
  _standby_ram_start = ORIGIN(standby_ram);
  _standby_ram_end = ORIGIN(standby_ram) + LENGTH(standby_ram);
  _standby_ram_fix_start = ORIGIN(standby_ram_fix);
  _standby_ram_fix_end = ORIGIN(standby_ram_fix) + LENGTH(standby_ram_fix);
}
